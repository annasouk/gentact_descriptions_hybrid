<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

<!-- Macro definition for head skin unit -->
<xacro:macro name="head_skin" params="parent namespace">
    <!-- Properties -->
    <xacro:property name="use_mesh_file" value="true" />
    <xacro:property name="mesh_file" value="${mesh_dir}skin/tof/head.stl" />
    <xacro:property name="mass" value="0.0" /> <!-- [kg] -->
    <xacro:property name="body_width" value="0.0" /> <!-- [m] -->
    <xacro:property name="body_height" value="0.0" /> <!-- [m] -->
    <xacro:property name="sensor_length" value="0.0" /> <!-- [m] -->
    <xacro:property name="sensor_radius" value="0.0" /> <!-- [m] -->

    <!-- Included URDF Files (NEEDED FOR BASE SKIN UNIT) -->
    <xacro:include filename="$(find gentact_descriptions_hybrid)/robots/common/skin_unit_base.xacro" />

    <!--
      STL exported in robot world frame from Blender full-robot scene.
      mesh_in_world_frame: true in sensors_config.yaml handles rendering:
      the mesh is drawn at its raw world coords (no transform applied).
      Head is rigid with torso_link (torso_link FK == identity), so the
      sensor origins below are expressed directly in robot world coords.
      Source: Blender sensor table (sensor_pos in head-local frame),
      offset by the fitted head-local->world translation
      (0.0622, 0.0006, 0.669) so each sensor lands on the head surface.
      rpy is the table's sensor_rpy; the sensor faces +z, so
      normal = R(rpy) @ [0,0,1] (the outward surface normal).
    -->
    <xacro:dermis_base_macro
    robot_namespace="${namespace}"
    parent="${parent}"
    mass="${mass}"
    body_width="${body_width}"
    body_height="${body_height}"
    use_mesh_file="${use_mesh_file}"
    mesh_file="${mesh_file}">
    <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:dermis_base_macro>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="0"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="0.032994"
        normal_y="-0.005000"
        normal_z="0.999443">
        <origin xyz="0.049 0.001 0.775" rpy="0.005 0.033 0.000" />
    </xacro:self_cap_sensor>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="1"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="0.914808"
        normal_y="0.002022"
        normal_z="0.403884">
        <origin xyz="0.129 0.003 0.721" rpy="-0.013 1.155 -0.012" />
    </xacro:self_cap_sensor>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="2"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="0.214449"
        normal_y="-0.841223"
        normal_z="0.496342">
        <origin xyz="0.059 -0.069 0.741" rpy="1.048 0.109 0.187" />
    </xacro:self_cap_sensor>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="4"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="-0.020242"
        normal_y="0.850838"
        normal_z="0.525037">
        <origin xyz="0.044 0.070 0.743" rpy="-1.018 -0.011 0.017" />
    </xacro:self_cap_sensor>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="3"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="-0.792712"
        normal_y="-0.146632"
        normal_z="0.591698">
        <origin xyz="-0.029 -0.003 0.744" rpy="0.386 -0.878 -0.303" />
    </xacro:self_cap_sensor>

    </xacro:macro>

</robot>
