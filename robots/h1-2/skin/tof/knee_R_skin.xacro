<?xml version="1.0"?>

<robot xmlns:xacro="http://ros.org/wiki/xacro">

<!-- Macro definition for right knee skin unit -->
<xacro:macro name="knee_R_skin" params="parent namespace">
    <!-- Properties -->
    <xacro:property name="use_mesh_file" value="true" />
    <xacro:property name="mesh_file" value="${mesh_dir}skin/tof/right_knee_link_skin.stl" />
    <xacro:property name="mass" value="0.0" /> <!-- [kg] -->
    <xacro:property name="body_width" value="0.0" /> <!-- [m] -->
    <xacro:property name="body_height" value="0.0" /> <!-- [m] -->
    <xacro:property name="sensor_length" value="0.0" /> <!-- [m] -->
    <xacro:property name="sensor_radius" value="0.0" /> <!-- [m] -->

    <!-- Included URDF Files (NEEDED FOR BASE SKIN UNIT) -->
    <xacro:include filename="$(find gentact_descriptions_hybrid)/robots/common/skin_unit_base.xacro" />

    <!--
      STL exported in robot world frame from Blender full-robot scene.
      mesh_in_world_frame: true — mesh drawn at raw world coords (no transform).
      sensor_pos / sensor_rpy from Blender are in the SKIN OBJECT local frame
      (same as the sensor table). dermis_base origin places that skin-object
      origin relative to right_knee_link so sensors land on the mesh:
        world = T_link @ T_dermis @ sensor_pos
      normal is the outward mesh surface normal at each point.
    -->
    <xacro:dermis_base_macro
    robot_namespace="${namespace}"
    parent="${parent}"
    mass="${mass}"
    body_width="${body_width}"
    body_height="${body_height}"
    use_mesh_file="${use_mesh_file}"
    mesh_file="${mesh_file}">
    <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:dermis_base_macro>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="0"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="0.982561"
        normal_y="0.082325"
        normal_z="-0.166725">
        <origin xyz="0.057 0.034 -0.132" rpy="1.7383 0.0000 1.6544" />
    </xacro:self_cap_sensor>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="1"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="0.995909"
        normal_y="0.000227"
        normal_z="-0.090357">
        <origin xyz="0.057 -0.003 -0.184" rpy="1.6613 0.0000 1.5710" />
    </xacro:self_cap_sensor>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="2"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="0.995909"
        normal_y="0.000227"
        normal_z="-0.090357">
        <origin xyz="0.056 -0.005 -0.231" rpy="1.6613 0.0000 1.5710" />
    </xacro:self_cap_sensor>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="3"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="0.000033"
        normal_y="-1.000000"
        normal_z="0.000906">
        <origin xyz="0.010 -0.055 -0.146" rpy="1.5699 0.0000 0.0000" />
    </xacro:self_cap_sensor>


    <xacro:self_cap_sensor
        robot_namespace="${namespace}"
        parent="${namespace}_skin"
        sensor_number="4"
        sensor_radius="${sensor_radius}"
        sensor_length="0.0"
        normal_x="-0.005527"
        normal_y="-0.995102"
        normal_z="-0.098699">
        <origin xyz="0.007 -0.055 -0.221" rpy="1.6697 0.0000 -0.0056" />
    </xacro:self_cap_sensor>

    </xacro:macro>

</robot>
